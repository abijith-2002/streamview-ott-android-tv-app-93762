<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Local, platform-compatible text appearances to replace MaterialComponents.* -->
    <!-- Uses platform Material or DeviceDefault fallbacks to avoid requiring MaterialComponents lib -->

    <!-- PUBLIC: Body1 -->
    <style name="TextAppearance.Body1" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/ocean_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- PUBLIC: Body2 (slightly smaller than Body1) -->
    <style name="TextAppearance.Body2" parent="@android:style/TextAppearance.Material.Body2">
        <item name="android:textColor">@color/ocean_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- PUBLIC: Subtitle1 -->
    <style name="TextAppearance.Subtitle1" parent="@android:style/TextAppearance.Material.Subhead">
        <item name="android:textColor">@color/ocean_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Streamly-specific appearances that are used throughout the app -->

    <!-- Navigation tab default -->
    <style name="TextAppearance.Streamly.Nav" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/tv_secondary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Navigation tab focused -->
    <style name="TextAppearance.Streamly.Nav.Focused" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/tv_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Content row title -->
    <style name="TextAppearance.Streamly.RowTitle" parent="@android:style/TextAppearance.Material.Subhead">
        <item name="android:textColor">@color/tv_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Card title -->
    <style name="TextAppearance.Streamly.CardTitle" parent="@android:style/TextAppearance.Material.Body2">
        <item name="android:textColor">@color/tv_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
