<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Android TV -->
    <style name="AppTheme" parent="Theme.Leanback">
        <!-- Customize your theme here -->
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:colorPrimary">@color/tv_accent</item>
        <!-- Using default Leanback widgets; explicit style refs removed to avoid missing resources -->
    </style>

    <!-- Minimalist Splash theme using Ocean Professional palette -->
    <style name="SplashTheme" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/ocean_background</item>
        <item name="android:colorPrimary">@color/ocean_primary</item>
    </style>
</resources>
