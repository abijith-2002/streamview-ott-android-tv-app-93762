<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackgroundDark"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="48dp"
    android:paddingBottom="48dp">

    <!-- Brand text area: horizontally centered between left screen edge (safe padding) and navbar's left edge -->
    <TextView
        android:id="@+id/brand_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Claro-video"
        android:textColor="@color/ocean_text"
        android:textStyle="bold"
        android:textSize="24sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_horizontal"
        android:includeFontPadding="false"
        android:ellipsize="end"
        android:singleLine="true"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/top_nav_background"
        app:layout_constraintTop_toTopOf="@id/top_nav_background"
        app:layout_constraintBottom_toBottomOf="@id/top_nav_background"/>

    <!-- Apply color span via TextAppearance isn't possible in XML; the red segment is set programmatically in HomeFragment -->
    <!-- Top navigation background container centered horizontally -->
    <android.view.View
        android:id="@+id/top_nav_background"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_top_nav_container"
        android:alpha="1.0"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintWidth_percent="0.62"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Top navigation bar: keep reduced height and prevent clipping; remains centered by constraining to background -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/top_nav_recycler"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:contentDescription="@string/top_navigation"
        android:nextFocusDown="@id/rails_recycler"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="@id/top_nav_background"
        app:layout_constraintBottom_toBottomOf="@id/top_nav_background"
        app:layout_constraintStart_toStartOf="@id/top_nav_background"
        app:layout_constraintEnd_toEndOf="@id/top_nav_background" />

    <!-- Vertical rails list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rails_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:overScrollMode="never"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:contentDescription="@string/content_rails"
        android:nextFocusUp="@id/top_nav_recycler"
        app:layout_constraintTop_toBottomOf="@id/top_nav_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
