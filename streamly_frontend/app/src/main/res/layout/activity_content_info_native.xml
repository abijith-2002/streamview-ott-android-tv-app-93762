<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_info_native_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackgroundDark">

    <!-- Backdrop image -->
    <ImageView
        android:id="@+id/info_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Gradient overlay bottom -->
    <View
        android:id="@+id/info_gradient"
        android:layout_width="0dp"
        android:layout_height="@dimen/info_gradient_height"
        android:background="@drawable/bg_bottom_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Top right clock -->
    <TextView
        android:id="@+id/info_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="@dimen/info_clock_text"
        android:padding="@dimen/info_clock_pad"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/info_margin_outer"
        android:layout_marginEnd="@dimen/info_margin_outer"/>

    <!-- Title -->
    <TextView
        android:id="@+id/info_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="@dimen/info_title_text"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/info_metadata"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="@dimen/info_margin_outer"
        android:layout_marginEnd="@dimen/info_margin_outer"
        android:layout_marginBottom="@dimen/info_spacing_small"/>

    <!-- Metadata chips/row -->
    <TextView
        android:id="@+id/info_metadata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/secondaryTextColor"
        android:textSize="@dimen/info_meta_text"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/info_synopsis"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="@dimen/info_margin_outer"
        android:layout_marginEnd="@dimen/info_margin_outer"
        android:layout_marginBottom="@dimen/info_spacing_small"/>

    <!-- Synopsis -->
    <TextView
        android:id="@+id/info_synopsis"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="@dimen/info_synopsis_text"
        android:maxLines="4"
        app:layout_constraintBottom_toTopOf="@+id/info_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="@dimen/info_margin_outer"
        android:layout_marginEnd="@dimen/info_margin_outer"
        android:layout_marginBottom="@dimen/info_spacing_large"/>

    <!-- Actions row -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/info_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="@dimen/info_margin_outer"
        android:layout_marginEnd="@dimen/info_margin_outer"
        android:layout_marginBottom="@dimen/info_margin_outer">

        <Button
            android:id="@+id/btn_play"
            style="@style/TvActionButton"
            android:layout_width="@dimen/info_btn_width"
            android:layout_height="@dimen/info_btn_height"
            android:text="@string/play"
            android:nextFocusRight="@id/btn_record"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <Button
            android:id="@+id/btn_record"
            style="@style/TvActionButton"
            android:layout_width="@dimen/info_btn_width"
            android:layout_height="@dimen/info_btn_height"
            android:text="@string/record"
            android:nextFocusLeft="@id/btn_play"
            app:layout_constraintStart_toEndOf="@id/btn_play"
            app:layout_constraintTop_toTopOf="@id/btn_play"
            android:layout_marginStart="@dimen/info_spacing_large"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
