<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top_nav_item_root"
    android:layout_width="wrap_content"
    android:layout_height="38dp"
    android:minHeight="38dp"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_top_nav_item"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipToPadding="false">

    <!-- Full-height label, with internal horizontal padding coming from the label itself -->
    <TextView
        android:id="@+id/top_nav_label"
        style="@style/TextAppearance.Streamly.Nav"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        android:textColor="@color/ocean_text"
        android:ellipsize="none"
        android:singleLine="true"
        android:includeFontPadding="true"
        android:foreground="@drawable/ripple_tv"
        android:text="Inicio" />

    <ImageView
        android:id="@+id/top_nav_icon"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:adjustViewBounds="true"
        android:scaleType="centerInside"
        android:contentDescription="@string/top_navigation"
        android:visibility="gone"
        android:foreground="@drawable/ripple_tv"
        android:src="@drawable/ic_search_tv" />

</FrameLayout>
